//@version=6
// Po3 · Accumulation → Manipulation → Distribution
// Reverse-engineered from a chart screenshot of "Po3 v2.4.0". Clean-room rebuild, not the original source.
// Cycle: compressed range (A) → boundary sweep + reclaim (M) → trade toward external liquidity (D).
indicator("Po3 · Accumulation / Manipulation / Distribution", shorttitle = "Po3", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpA = "Accumulation (range)"
minBars  = input.int(20, "Min range bars", minval = 5, group = grpA, tooltip = "Bars the compression window must span before a range is locked.")
atrLen   = input.int(50, "ATR length", minval = 5, group = grpA)
maxWidth = input.float(4.5, "Max range width (×ATR)", minval = 0.5, step = 0.25, group = grpA)
pctLen   = input.int(200, "Compression lookback", minval = 20, maxval = 1000, group = grpA, tooltip = "Percentile rank of the normalized range width over this many bars. Lower = tighter.")
maxPct   = input.int(25, "Max compression percentile", minval = 1, maxval = 100, group = grpA)
maxAge   = input.int(150, "Range expiry (bars)", minval = 10, group = grpA, tooltip = "Range resets (e) if no sweep happens within this many bars.")

grpM = "Manipulation (sweep)"
minPen   = input.float(0.05, "Min sweep depth (×ATR)", minval = 0.0, step = 0.05, group = grpM)
maxPen   = input.float(1.5, "Max sweep depth (×ATR)", minval = 0.1, step = 0.1, group = grpM, tooltip = "Deeper than this is a breakout, not a sweep.")
reclaimN = input.int(3, "Bars allowed to reclaim", minval = 0, group = grpM, tooltip = "Close back inside within this many bars = trade. A later reclaim counts as Failed.")
brkAtr   = input.float(0.75, "Breakout close (×ATR beyond boundary)", minval = 0.1, step = 0.05, group = grpM)

grpD = "Distribution (trade)"
tgtMode  = input.string("Liquidity", "Target", options = ["Liquidity", "Range projection", "Fixed R"], group = grpD, tooltip = "Liquidity: nearest unswept swing high/low beyond the range (falls back to Range projection).")
projMult = input.float(1.0, "Projection (×range height)", minval = 0.1, step = 0.1, group = grpD)
fixedR   = input.float(2.0, "Fixed R", minval = 0.5, step = 0.25, group = grpD)
pivLen   = input.int(10, "Liquidity pivot length", minval = 2, group = grpD)
stopBuf  = input.float(0.1, "Stop buffer beyond sweep (×ATR)", minval = 0.0, step = 0.05, group = grpD)
minRR    = input.float(1.5, "Min R:R", minval = 0.1, step = 0.1, group = grpD, tooltip = "Setups below this reset the cycle (f).")
maxTrade = input.int(60, "Trade timeout (bars)", minval = 1, group = grpD)

grpF = "Filters"
htfMode  = input.string("Off", "HTF bias", options = ["Off", "EMA"], group = grpF, tooltip = "EMA: only trade in the direction of the higher-timeframe close vs its EMA. Blocked setups reset the cycle (y).")
htfTf    = input.timeframe("240", "HTF timeframe", group = grpF, tooltip = "Auto-promoted to the next higher of 240 / D / W / M / 12M when not above the chart timeframe.")
htfLen   = input.int(50, "HTF EMA length", minval = 2, group = grpF)
optTf    = input.timeframe("15", "Optimal timeframe", group = grpF, tooltip = "Dashboard warns when the chart timeframe differs.")
confirm  = input.bool(true, "Confirm on bar close (no repaint)", group = grpF, tooltip = "Off = intrabar signals. Drawings and alerts may repaint.")

grpV = "Visuals"
showHist = input.bool(true, "Keep past cycles (faded)", group = grpV)
show1R   = input.bool(true, "Show 1R level", group = grpV)
showDash = input.bool(true, "Show dashboard", group = grpV)
dashPos  = input.string("Top Right", "Dashboard position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpV)
dashSize = input.string("Small", "Dashboard size", options = ["Tiny", "Small", "Normal"], group = grpV)
colBull  = input.color(#26a69a, "Bull", group = grpV)
colBear  = input.color(#ef5350, "Bear", group = grpV)
colBrk   = input.color(#ff9800, "Breakout / manipulation", group = grpV)
colAcc   = input.color(color.gray, "Accumulation", group = grpV)
colHead  = input.color(#1e53e5, "Dashboard header", group = grpV)

// ─────────────────────────────────────────────────────────────────────────────
// Series
// ─────────────────────────────────────────────────────────────────────────────
atr = ta.atr(atrLen)
hh  = ta.highest(high, minBars)
ll  = ta.lowest(low, minBars)
nw  = (hh - ll) / atr
pct = ta.percentrank(nw, pctLen)
ph  = ta.pivothigh(high, pivLen, pivLen)
pl  = ta.pivotlow(low, pivLen, pivLen)
go  = (barstate.isconfirmed or not confirm) and not na(atr) and not na(pct)

cs     = timeframe.in_seconds()
htfUse = timeframe.in_seconds(htfTf) > cs ? htfTf : cs < 14400 ? "240" : cs < 86400 ? "D" : cs < 604800 ? "W" : cs < 2592000 ? "M" : "12M"
[htfC, htfE] = request.security(syminfo.tickerid, htfUse, [close[1], ta.ema(close, htfLen)[1]], lookahead = barmerge.lookahead_on)
bias = htfMode == "Off" or na(htfE) ? 0 : htfC > htfE ? 1 : htfC < htfE ? -1 : 0

// Unswept swing highs/lows = external liquidity pools
var array<float> liqHi = array.new<float>()
var array<float> liqLo = array.new<float>()
if not na(ph)
    liqHi.push(ph)
    if liqHi.size() > 100
        liqHi.shift()
if not na(pl)
    liqLo.push(pl)
    if liqLo.size() > 100
        liqLo.shift()
if liqHi.size() > 0
    for i = liqHi.size() - 1 to 0
        if high > liqHi.get(i)
            liqHi.remove(i)
if liqLo.size() > 0
    for i = liqLo.size() - 1 to 0
        if low < liqLo.get(i)
            liqLo.remove(i)

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
f_above(array<float> a, float lvl) =>
    float best = na
    for v in a
        if v > lvl and (na(best) or v < best)
            best := v
    best

f_below(array<float> a, float lvl) =>
    float best = na
    for v in a
        if v < lvl and (na(best) or v > best)
            best := v
    best

f_px(float p) =>
    str.tostring(p, format.mintick)

f_chg(float p, float ref) =>
    v = (p - ref) / ref * 100
    (v >= 0 ? "+" : "") + str.tostring(v, "#.##") + "%"

f_r(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R"

f_meter(float frac, int n) =>
    k = math.round(math.max(0.0, math.min(1.0, frac)) * n)
    string s = ""
    for i = 1 to n
        s += i <= k ? "▰" : "▱"
    s

f_tf(string tf) =>
    string r = ""
    if str.endswith(tf, "M")
        r := (tf == "M" ? "1" : str.replace(tf, "M", "")) + "Mo"
    else
        s = timeframe.in_seconds(tf)
        r := na(s) ? tf : s % 604800 == 0 ? str.tostring(math.round(s / 604800)) + "W" : s % 86400 == 0 ? str.tostring(math.round(s / 86400)) + "D" : s % 3600 == 0 ? str.tostring(math.round(s / 3600)) + "H" : s % 60 == 0 ? str.tostring(math.round(s / 60)) + "M" : str.tostring(s) + "S"
    r

// Fade (or delete) a set of drawings, then empty the arrays.
f_fade(array<line> ls, array<label> lbs, array<box> bs, bool keep) =>
    for l in ls
        if keep
            l.set_color(color.new(color.gray, 65))
        else
            l.delete()
    for lb in lbs
        if keep
            lb.set_color(color.new(color.gray, 85))
            lb.set_textcolor(color.new(color.gray, 40))
        else
            lb.delete()
    for b in bs
        if keep
            b.set_bgcolor(color.new(color.gray, 93))
            b.set_border_color(color.new(color.gray, 70))
        else
            b.delete()
    ls.clear()
    lbs.clear()
    bs.clear()

// Move current-cycle drawings into the "last cycle" bucket.
f_move(array<line> sl, array<label> slb, array<box> sb, array<line> dl, array<label> dlb, array<box> db) =>
    dl.concat(sl)
    dlb.concat(slb)
    db.concat(sb)
    sl.clear()
    slb.clear()
    sb.clear()

// ─────────────────────────────────────────────────────────────────────────────
// State
// 0 scan · 1 accumulation · 2 manipulation (sweep pending reclaim) · 3 distribution (trade)
// ─────────────────────────────────────────────────────────────────────────────
var int   state  = 0
var int   coolUntil = 0   // next range window must not overlap the last cycle
var float rHi    = na
var float rLo    = na
var int   rStart = na
var box   rBox   = na
var int   sDir   = 0      // +1 low swept → long, -1 high swept → short
var float sExt   = na
var int   sBar   = na
var label mLb    = na
var int   tDir   = 0
var int   tBar   = na
var float eP     = na
var float sP     = na
var float tP     = na
var float risk   = na
var box   pBox   = na
var line  eLn    = na
var line  sLn    = na
var line  tLn    = na
var line  oLn    = na
var label eLb    = na
var label sLb    = na
var label tLb    = na

// current-cycle drawings, last finished cycle (kept vivid), everything older is faded
var array<line>  cL  = array.new<line>()
var array<label> cLb = array.new<label>()
var array<box>   cB  = array.new<box>()
var array<line>  pL  = array.new<line>()
var array<label> pLb = array.new<label>()
var array<box>   pB  = array.new<box>()

// all-time stats
var int   nCyc  = 0
var int   nTgt  = 0
var int   nStop = 0
var int   nTo   = 0
var int   nFail = 0
var int   nBrk  = 0
var int   rsE   = 0   // expired: no sweep before maxAge
var int   rsN   = 0   // neutral: both boundaries swept on one bar
var int   rsY   = 0   // yielded: HTF bias blocked the setup
var int   rsF   = 0   // filtered: setup below min R:R
var float sumR  = 0.0
var array<int> form = array.new<int>()   // 1 target · -1 stop · 0 timeout

// per-bar events
bool evSweep = false
bool evLong  = false
bool evShort = false
bool evTgt   = false
bool evStop  = false
bool evTo    = false
bool evBrk   = false
bool evFail  = false

bool doSetup = false
bool doBrk   = false
bool doFail  = false
int  rsCode  = 0    // 1 e · 2 n · 3 y · 4 f

if go
    if state == 0
        if bar_index >= minBars and bar_index >= coolUntil and nw <= maxWidth and pct <= maxPct
            state  := 1
            rHi    := hh
            rLo    := ll
            rStart := bar_index - minBars + 1
            rBox   := box.new(rStart, rHi, bar_index, rLo, border_color = color.new(colAcc, 40), border_style = line.style_dashed, bgcolor = color.new(colAcc, 94))
            cB.push(rBox)

    else if state == 1
        rBox.set_right(bar_index)
        up = high > rHi + minPen * atr
        dn = low < rLo - minPen * atr
        if up and dn
            rsCode := 2
        else if up or dn
            sDir    := dn ? 1 : -1
            sExt    := dn ? low : high
            sBar    := bar_index
            evSweep := true
            mLb     := label.new(bar_index, sExt, "M", style = dn ? label.style_label_up : label.style_label_down, color = color.new(colBrk, 20), textcolor = color.white, size = size.tiny)
            cLb.push(mLb)
            pen    = dn ? rLo - sExt : sExt - rHi
            beyond = dn ? rLo - close : close - rHi
            if pen > maxPen * atr or beyond > brkAtr * atr
                doBrk := true
            else if close > rLo and close < rHi
                doSetup := true
            else
                state := 2
        else if bar_index - rStart > maxAge
            rsCode := 1

    else if state == 2
        rBox.set_right(bar_index)
        if (sDir == 1 and low < sExt) or (sDir == -1 and high > sExt)
            sExt := sDir == 1 ? low : high
            mLb.set_xy(bar_index, sExt)
        pen    = sDir == 1 ? rLo - sExt : sExt - rHi
        beyond = sDir == 1 ? rLo - close : close - rHi
        if pen > maxPen * atr or beyond > brkAtr * atr
            doBrk := true
        else if close > rLo and close < rHi
            // reclaim in time = trade, too late = failed manipulation
            if bar_index - sBar <= reclaimN
                doSetup := true
            else
                doFail := true
        else if bar_index - rStart > maxAge and bar_index - sBar > reclaimN
            doFail := true

    else if state == 3 and bar_index > tBar
        pBox.set_right(bar_index)
        for l in array.from(eLn, sLn, tLn)
            l.set_x2(bar_index)
        if show1R
            oLn.set_x2(bar_index)
        for lb in array.from(eLb, sLb, tLb)
            lb.set_x(bar_index)

        hitS = tDir == 1 ? low <= sP : high >= sP
        hitT = tDir == 1 ? high >= tP : low <= tP
        int   res = na
        float px  = na
        if hitS   // stop first when both print on one bar (conservative)
            res := -1
            px  := tDir == 1 ? math.min(open, sP) : math.max(open, sP)
        else if hitT   // filled at target even on a gap through it (conservative)
            res := 1
            px  := tP
        else if bar_index - tBar >= maxTrade
            res := 0
            px  := close

        if not na(res)
            r = (px - eP) * tDir / risk
            nCyc += 1
            sumR += r
            form.push(res)
            if form.size() > 10
                form.shift()
            okC = res == 1 ? colBull : res == -1 ? colBear : color.gray
            mark = res == 1 ? "✓ " : res == -1 ? "✗ " : "⧗ "
            if res == 1
                nTgt  += 1
                evTgt := true
                tLb.set_text("Target ✓ " + f_px(tP))
            else if res == -1
                nStop  += 1
                evStop := true
                sLb.set_text("Stop ✗ " + f_px(sP))
            else
                nTo  += 1
                evTo := true
            up = (res == 1) == (tDir == 1)
            cLb.push(label.new(bar_index, up ? high : low, mark + f_r(r), style = up ? label.style_label_down : label.style_label_up, color = okC, textcolor = color.white, size = size.small))
            f_fade(pL, pLb, pB, showHist)
            f_move(cL, cLb, cB, pL, pLb, pB)
            coolUntil := bar_index + minBars
            state := 0

    // ── resolve transitions raised above ──
    if doSetup
        h  = rHi - rLo
        e  = close
        s  = sDir == 1 ? sExt - stopBuf * atr : sExt + stopBuf * atr
        rk = math.abs(e - s)
        float t = na
        if tgtMode == "Fixed R"
            t := e + sDir * rk * fixedR
        else if tgtMode == "Range projection"
            t := sDir == 1 ? rHi + h * projMult : rLo - h * projMult
        else
            floorT = sDir == 1 ? math.max(rHi, e + rk * minRR) : math.min(rLo, e - rk * minRR)
            t := sDir == 1 ? f_above(liqHi, floorT) : f_below(liqLo, floorT)
            if na(t)
                t := sDir == 1 ? rHi + h * projMult : rLo - h * projMult
        rr = rk > 0 ? (t - e) * sDir / rk : 0.0
        if rk <= 0 or rr < minRR
            rsCode := 4
        else if bias != 0 and bias != sDir
            rsCode := 3
        else
            f_fade(pL, pLb, pB, showHist)
            state := 3
            tDir  := sDir
            tBar  := bar_index
            eP    := e
            sP    := s
            tP    := t
            risk  := rk
            col   = tDir == 1 ? colBull : colBear
            r1    = e + tDir * rk
            // one zone from the sweep extreme to the target, like the original
            pBox := box.new(bar_index, math.max(sExt, t), bar_index, math.min(sExt, t), border_color = color.new(col, 100), bgcolor = color.new(col, 88))
            eLn  := line.new(bar_index, e, bar_index, e, color = chart.fg_color, width = 2)
            sLn  := line.new(bar_index, s, bar_index, s, color = colBear, width = 2)
            tLn  := line.new(bar_index, t, bar_index, t, color = color.new(#1b5e20, 0), width = 2)
            eLb  := label.new(bar_index, e, "Entry " + f_px(e), style = label.style_label_left, color = color.new(#263238, 0), textcolor = color.white, size = size.small)
            sLb  := label.new(bar_index, s, "Stop " + f_px(s) + " (" + f_chg(s, e) + ")", style = label.style_label_left, color = colBear, textcolor = color.white, size = size.small)
            tLb  := label.new(bar_index, t, "Target " + f_px(t) + " (" + f_chg(t, e) + ")", style = label.style_label_left, color = color.new(#1b5e20, 0), textcolor = color.white, size = size.small)
            dLb   = label.new(bar_index, tDir == 1 ? low - 0.6 * atr : high + 0.6 * atr, tDir == 1 ? "D▲" : "D▼", style = tDir == 1 ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.small)
            cB.push(pBox)
            for l in array.from(eLn, sLn, tLn)
                cL.push(l)
            for lb in array.from(eLb, sLb, tLb, dLb)
                cLb.push(lb)
            if show1R
                oLn := line.new(bar_index, r1, bar_index, r1, color = color.new(chart.fg_color, 60), style = line.style_dotted)
                cL.push(oLn)
                cLb.push(label.new(bar_index, r1, "1R", style = label.style_label_right, color = color.new(color.gray, 100), textcolor = color.new(chart.fg_color, 40), size = size.tiny))
            evLong  := tDir == 1
            evShort := tDir == -1

    if doBrk
        nBrk  += 1
        evBrk := true
        bnd    = sDir == 1 ? rLo : rHi
        ext    = sDir == 1 ? math.min(sExt, close) : math.max(sExt, close)
        mLb.delete()
        // fade the dead range only; the last finished trade stays vivid
        f_fade(cL, cLb, cB, showHist)
        bb = box.new(sBar, math.max(bnd, ext), bar_index, math.min(bnd, ext), border_color = color.new(colBrk, 60), bgcolor = color.new(colBrk, 75))
        bl = label.new(bar_index, bnd, "BREAKOUT", style = sDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 20), textcolor = color.white, size = size.small)
        if not showHist   // otherwise breakouts stay orange, as on the original
            pB.push(bb)
            pLb.push(bl)
        coolUntil := bar_index + minBars
        state := 0

    if doFail
        nFail  += 1
        evFail := true
        f_fade(cL, cLb, cB, showHist)
        coolUntil := bar_index + minBars
        state := 0

    if rsCode != 0
        if rsCode == 1
            rsE += 1
        else if rsCode == 2
            rsN += 1
        else if rsCode == 3
            rsY += 1
        else
            rsF += 1
        f_fade(cL, cLb, cB, showHist)
        coolUntil := bar_index + minBars
        state := 0

// ─────────────────────────────────────────────────────────────────────────────
// Dashboard
// ─────────────────────────────────────────────────────────────────────────────
tPos = switch dashPos
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right
tSz = switch dashSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table tb = table.new(tPos, 2, 20, frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 80), border_width = 1)

f_sec(table t, int r, string txt, color bg, color fg, string sz) =>
    table.cell(t, 0, r, txt, text_color = fg, bgcolor = bg, text_size = sz)
    table.cell(t, 1, r, "", bgcolor = bg, text_size = sz)

f_row(table t, int r, string k, string v, color vc, color bg, color fg, string sz) =>
    table.cell(t, 0, r, k, text_color = fg, bgcolor = bg, text_size = sz)
    table.cell(t, 1, r, v, text_color = vc, bgcolor = bg, text_size = sz)

if showDash and barstate.islast
    bg   = chart.bg_color
    fg   = chart.fg_color
    dim  = color.new(fg, 45)
    secBg = color.new(color.gray, 90)
    age  = state >= 1 and not na(rStart) ? bar_index - rStart + 1 : 0

    phase = state == 0 ? "SCANNING" : state == 1 ? "ACCUMULATION" : state == 2 ? "MANIPULATION" : tDir == 1 ? "DISTRIBUTION ▲" : "DISTRIBUTION ▼"
    phCol = state == 0 ? dim : state == 1 ? colAcc : state == 2 ? colBrk : tDir == 1 ? colBull : colBear
    phTxt = phase + (state == 1 or state == 2 ? " (" + str.tostring(age) + "b)" : "")

    cmpTxt = na(pct) ? "—" : str.tostring(math.round(pct)) + "p  " + f_meter((100 - pct) / 100, 6)
    cmpCol = not na(pct) and pct <= maxPct ? colBull : dim
    rngTxt = state >= 1 ? f_px(rLo) + " – " + f_px(rHi) : "—"
    biasTxt = htfMode == "Off" ? "Off" : bias == 1 ? "Bull ▲ (" + f_tf(htfUse) + ")" : bias == -1 ? "Bear ▼ (" + f_tf(htfUse) + ")" : "Flat"
    biasCol = bias == 1 ? colBull : bias == -1 ? colBear : fg
    tfOk  = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds(optTf)
    tfTxt = f_tf(timeframe.period) + (tfOk ? "" : " ⚠ (opt: " + f_tf(optTf) + ")")

    openR = state == 3 and risk > 0 ? (close - eP) * tDir / risk : 0.0
    cyc = state == 0 ? "Scanning for compression" : state == 1 ? "Awaiting boundary sweep" : state == 2 ? "Sweep " + (sDir == 1 ? "↓ low" : "↑ high") + (bar_index - sBar > reclaimN ? " · reclaim window closed (late = Failed)" : " · awaiting reclaim (" + str.tostring(bar_index - sBar) + "/" + str.tostring(reclaimN) + ")") : (tDir == 1 ? "Long" : "Short") + " active · " + f_r(openR) + " open"
    cycCol = state == 3 ? (openR >= 0 ? colBull : colBear) : fg

    tRate = nCyc > 0 ? nTgt * 100.0 / nCyc : 0.0
    sRate = nCyc > 0 ? nStop * 100.0 / nCyc : 0.0
    oRate = nCyc > 0 ? nTo * 100.0 / nCyc : 0.0
    avgR  = nCyc > 0 ? sumR / nCyc : 0.0
    string frm = ""
    for v in form
        frm += v == 1 ? "■" : v == -1 ? "□" : "▣"

    table.cell(tb, 0, 0, "◆ Po3 · " + phase, text_color = color.white, bgcolor = colHead, text_size = tSz)
    table.cell(tb, 1, 0, "", bgcolor = colHead, text_size = tSz)
    f_sec(tb, 1, "— Market —", secBg, dim, tSz)
    f_row(tb, 2, "Phase", phTxt, phCol, bg, fg, tSz)
    f_row(tb, 3, "Compression", cmpTxt, cmpCol, bg, fg, tSz)
    f_row(tb, 4, "Range", rngTxt, fg, bg, fg, tSz)
    f_row(tb, 5, "HTF Bias", biasTxt, biasCol, bg, fg, tSz)
    f_row(tb, 6, "TF", tfTxt, tfOk ? fg : colBrk, bg, fg, tSz)
    f_sec(tb, 7, "— Cycle —", secBg, dim, tSz)
    f_sec(tb, 8, cyc, bg, cycCol, tSz)
    f_sec(tb, 9, "— Stats · All-Time —", secBg, dim, tSz)
    f_row(tb, 10, "Cycles", str.tostring(nCyc), fg, bg, fg, tSz)
    f_row(tb, 11, "Target", str.tostring(nTgt) + " (" + str.tostring(tRate, "0.0") + "%)", colBull, bg, fg, tSz)
    f_row(tb, 12, "Stop", str.tostring(nStop) + " (" + str.tostring(sRate, "0.0") + "%)", colBear, bg, fg, tSz)
    f_row(tb, 13, "Timeout", str.tostring(nTo) + " (" + str.tostring(oRate, "0.0") + "%)", fg, bg, fg, tSz)
    f_row(tb, 14, "Target rate", str.tostring(tRate, "0.0") + "%  " + f_meter(tRate / 100, 10), tRate >= 50 ? colBull : colBear, bg, fg, tSz)
    f_row(tb, 15, "Avg R", str.tostring(avgR, "0.0") + "R", avgR >= 0 ? colBull : colBear, bg, fg, tSz)
    f_row(tb, 16, "Form", frm == "" ? "—" : frm, fg, bg, fg, tSz)
    f_row(tb, 17, "Failed / Breakout · All-Time", str.tostring(nFail) + " / " + str.tostring(nBrk), fg, bg, fg, tSz)
    f_row(tb, 18, "Resets (e/n/y/f) · All-Time", str.tostring(rsE) + " / " + str.tostring(rsN) + " / " + str.tostring(rsY) + " / " + str.tostring(rsF), fg, bg, fg, tSz)
    f_sec(tb, 19, "Po3 · v2.4.0-re", bg, dim, size.tiny)
    table.cell_set_tooltip(tb, 1, 17, "Failed: sweep reclaimed too late, or never before range expiry (no trade). Breakout: decisive close or wick through the boundary.")
    table.cell_set_tooltip(tb, 1, 18, "e expired (no sweep in time) · n neutral (both sides swept on one bar) · y yielded to HTF bias · f filtered (R:R below min)")

    for r in array.from(0, 1, 7, 8, 9, 19)
        table.merge_cells(tb, 0, r, 1, r)

// Pending-cycle marker (the red "?" right of the live range)
var label qLb = na
if barstate.islast
    qLb.delete()
    if state == 1 or state == 2
        qLb := label.new(bar_index + 3, (rHi + rLo) / 2, "?", style = label.style_label_left, color = color.new(colBear, 100), textcolor = colBear, size = size.large)

// ─────────────────────────────────────────────────────────────────────────────
// Outputs & alerts
// ─────────────────────────────────────────────────────────────────────────────
plotshape(evLong, "D▲ long", shape.triangleup, location.belowbar, colBull, size = size.tiny, display = display.data_window)
plotshape(evShort, "D▼ short", shape.triangledown, location.abovebar, colBear, size = size.tiny, display = display.data_window)

alertcondition(evSweep, "Po3 · Boundary sweep", "Po3: range boundary swept on {{ticker}} ({{interval}})")
alertcondition(evLong, "Po3 · Long (D▲)", "Po3: long distribution signal on {{ticker}} at {{close}}")
alertcondition(evShort, "Po3 · Short (D▼)", "Po3: short distribution signal on {{ticker}} at {{close}}")
alertcondition(evTgt, "Po3 · Target hit", "Po3: target hit on {{ticker}}")
alertcondition(evStop, "Po3 · Stop hit", "Po3: stop hit on {{ticker}}")
alertcondition(evTo, "Po3 · Timeout", "Po3: trade timed out on {{ticker}}")
alertcondition(evBrk, "Po3 · Breakout", "Po3: range breakout (no reclaim) on {{ticker}}")
alertcondition(evFail, "Po3 · Failed reclaim", "Po3: sweep failed to reclaim on {{ticker}}")

if evLong or evShort
    alert("Po3 " + (evLong ? "LONG" : "SHORT") + " " + syminfo.ticker + " · entry " + f_px(eP) + " · stop " + f_px(sP) + " · target " + f_px(tP) + " · " + f_r((tP - eP) * tDir / risk), alert.freq_once_per_bar_close)
