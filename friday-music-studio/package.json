{
  "name": "friday-music-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop studio for original songs, lyric videos and approved YouTube releases.",
  "main": "dist/main/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke-electron.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
